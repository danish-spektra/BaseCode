{
  "if": {
    "anyOf": [
      {
        "not": {
          "anyOf": [
            {
              "field": "type",
              "like": "Microsoft.Compute/disks/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Compute/virtualMachines/*"
            },
            {
              "field": "type",
              "like": "Microsoft.OperationalInsights/workspaces/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Compute/virtualMachines/extensions/*"
            },
            {
              "field": "type",
              "like": "Microsoft.DataMigration/services/*"
            },
            {
              "field": "type",
              "like": "Microsoft.DataMigration/services/projects/*"
            },
            {
              "field": "type",
              "like": "Microsoft.DataMigration/sqlMigrationServices/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Migrate/migrateprojects/*"
            },
            {
              "field": "type",
              "like": "microsoft.insights/actiongroups/*"
            },
            {
              "field": "type",
              "like": "microsoft.insights/components/*"
            },
            {
              "field": "type",
              "like": "microsoft.insights/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/networkInterfaces/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/networkSecurityGroups/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/publicIPAddresses/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/virtualNetworks/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/firewallPolicies/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/azureFirewalls/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/applicationGateways/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Network/applicationGatewayWebApplicationFirewallPolicies/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Sql/servers/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Sql/servers/databases/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Storage/storageAccounts/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Web/serverFarms/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Web/sites/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Web/sites/slots/*"
            },
            {
              "field": "type",
              "like": "Microsoft.KeyVault/vaults/*"
            },
            {
              "field": "type",
              "like": "Microsoft.LoadTestService/loadTests/*"
            },
            {
              "field": "type",
              "in": [
                "Microsoft.OperationalInsights/workspaces",
                "Microsoft.LoadTestService/loadTests",
                "Microsoft.KeyVault/vaults",
                "Microsoft.Network/applicationGateways",
                "Microsoft.Network/applicationGatewayWebApplicationFirewallPolicies",
                "Microsoft.Network/firewallPolicies",
                "Microsoft.Network/azureFirewalls",
                "Microsoft.Compute/disks",
                "Microsoft.Compute/virtualMachines",
                "Microsoft.Compute/virtualMachines/extensions",
                "Microsoft.DataMigration/services",
                "Microsoft.DataMigration/services/projects",
                "Microsoft.DataMigration/sqlMigrationServices",
                "Microsoft.Migrate/migrateprojects",
                "microsoft.insights/actiongroups",
                "microsoft.insights/components",
                "microsoft.insights",
                "Microsoft.Network/networkInterfaces",
                "Microsoft.Network/networkSecurityGroups",
                "Microsoft.Network/publicIPAddresses",
                "Microsoft.Network/virtualNetworks",
                "Microsoft.Sql/servers",
                "Microsoft.Sql/servers/databases",
                "Microsoft.Storage/storageAccounts",
                "Microsoft.Web/serverFarms",
                "Microsoft.Web/sites",
                "Microsoft.Web/sites/slots"
              ]
            }
          ]
        }
      },

      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/disks"
          },
          {
            "not": {
              "field": "Microsoft.Compute/disks/Sku.Tier",
              "in": [
                "Premium"
              ]
            }
          }
        ]
      },

      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "not": {
              "allOf": [
                {
                  "field": "Microsoft.Compute/virtualMachines/imageOffer",
                  "in": [
                    "SQL2012SP4-WS2012R2",
                    "windowsserverdotnet",
                    "sql2019-ws2019",
                    "visualstudiowsplustools"
                  ]
                },
                {
                  "field": "Microsoft.Compute/virtualMachines/imagePublisher",
                  "in": [
                    "MicrosoftSQLServer",
                    "microsoftwindowsserver",
                    "microsoftvisualstudio"
                  ]
                },
                {
                  "field": "Microsoft.Compute/virtualMachines/imageSku",
                  "in": [
                    "Standard",
                    "ws2019-dotnetcore-2-2",
                    "vs-2022-com-ws2025-datacenter-azure-gen2"
                  ]
                },
                {
                  "field": "Microsoft.Compute/virtualMachines/sku.name",
                  "in": [
                    "Standard_D2s_v3"
                  ]
                }
              ]
            }
          }
        ]
      },

      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.SQL/servers/databases"
          },
          {
            "not": {
              "field": "Microsoft.Sql/servers/databases/requestedServiceObjectiveName",
              "in": [
                "S0",
                "System0",
                "GP_SYSTEM_4"
              ]
            }
          }
        ]
      },

      {
        "allOf": [
          {
            "source": "action",
            "equals": "Microsoft.Storage/storageAccounts/write"
          },
          {
            "field": "type",
            "equals": "Microsoft.Storage/storageAccounts"
          },
          {
            "not": {
              "field": "Microsoft.Storage/storageAccounts/sku.name",
              "in": [
                "Standard_LRS",
                "StandardLRS"
              ]
            }
          }
        ]
      },

      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Web/serverfarms"
          },
          {
            "not": {
              "field": "Microsoft.Web/serverfarms/sku.name",
              "in": [
                "P1v2",
                "Y1",
                "S1"
              ]
            }
          }
        ]
      },

      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/applicationGateways"
          },
          {
            "not": {
              "field": "Microsoft.Network/applicationGateways/Sku.Tier",
              "in": [
                "WAF_v2"
              ]
            }
          }
        ]
      }
    ]
  },
  "then": {
    "effect": "deny"
  }
}